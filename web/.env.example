# Copy to .env.local. Local Supabase (npx supabase start) prints these values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Server-only. Never expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Exchange rates: fixed demo table until a provider is wired in
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to 1 only on local/dev databases seeded with the demo accounts
ONETRIP_DEMO=0
